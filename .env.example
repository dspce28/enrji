# Copy to .env (or set in your host) — all optional in development.
PORT=3000
BASE_URL=http://localhost:3000          # public URL; used for Stripe return links and Secure cookies (https)
DATABASE_PATH=data/enrji.db
ADMIN_EMAIL=admin@enrji.local
ADMIN_PASSWORD=change-me                 # required when NODE_ENV=production

# Real payments via Stripe Checkout (test keys start with sk_test_)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=                   # from `stripe listen` or the dashboard webhook endpoint

# Simulated card processor. Defaults to on in development, off in production.
DEMO_PAYMENTS=
