# ENRJI's own store (leave DATABASE_URL unset to keep running on Shopify)
DATABASE_URL=              # Postgres (Neon via Vercel → Storage). Set = the site switches to the own store.
AUTH_SECRET=               # long random string; signs login codes
ADMIN_PHONES=              # comma-separated mobile numbers that get admin access, e.g. 9876543210
OTP_ON_SCREEN=             # "true"/"false" to force; by default codes show on screen only while ALLOW_INDEXING isn't "true"
RAZORPAY_KEY_ID=           # rzp_test_… while testing
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=   # Razorpay → Settings → Webhooks, URL https://<site>/api/webhooks/razorpay
